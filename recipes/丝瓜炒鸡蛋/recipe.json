{
  "title": "丝瓜炒鸡蛋",
  "subtitle": "饭店做法 · 不出水不发黑",
  "meta": ["家常快手菜", "焯水 1 分钟", "全程大火快炒"],
  "notes": "三个诀窍：① 切菱形条不易出水；② 焯水加盐和油，丝瓜翠绿不发黑、还能去草酸；③ 炒鸡蛋要宽油烧热，蓬松不粘锅，扒拉五六下就盛出。来源：B站 UP主「超子美食」BV1B64y1B7Zn，文字版见人民号。",
  "steps": [
    {
      "label": "① 切丝瓜",
      "action": "去皮洗净，一分为四，斜刀切菱形条",
      "ingredients": ["丝瓜 2 根"]
    },
    {
      "label": "② 打蛋液",
      "action": "充分搅散至筷子挑不起来（不加盐）",
      "ingredients": ["鸡蛋 3 个"]
    },
    {
      "label": "③ 备料头",
      "action": "蒜拍扁切末",
      "ingredients": ["大蒜 3~4 瓣", "小米辣 2~3 个（可选）"]
    },
    {
      "label": "④ 焯水",
      "action": "水开下丝瓜焯约 1 分钟捞出（盐油保翠绿不发黑）",
      "ingredients": ["清水 半锅", "食盐 1 勺", "色拉油 1 勺"]
    },
    {
      "label": "⑤ 炒鸡蛋",
      "action": "油烧热下蛋液，炒散至微黄盛出",
      "ingredients": ["食用油 适量（宽油）", "蛋液（②打好）"]
    },
    {
      "label": "⑥ 爆香",
      "action": "不刷锅，底油小火爆香",
      "ingredients": ["食用油 少许", "蒜末、小米辣（③备好）"]
    },
    {
      "label": "⑦ 回锅",
      "action": "下锅，大火翻炒均匀",
      "span_from": 5,
      "ingredients": ["丝瓜（④焯好）", "鸡蛋（⑤炒好）"]
    },
    {
      "label": "⑧ 调味",
      "action": "调味，淋清水翻炒入味",
      "span_from": 5,
      "ingredients": ["食盐 适量", "鸡精 半勺", "生抽 小半勺", "清水 少许"]
    },
    {
      "label": "⑨ 出锅",
      "action": "出锅装盘",
      "ingredients": []
    }
  ]
}
